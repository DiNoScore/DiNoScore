<interface>
  <template class="GtkListItem">
    <property name="child">
      <object class="GtkBox">
        <property name="halign">center</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPicture">
            <binding name="paintable">
              <lookup name="thumbnail" type="ViewerLibraryItem">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
            <property name="can-shrink">False</property>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="halign">center</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">starred-symbolic</property>
                <binding name="visible">
                  <lookup name="favorite" type="ViewerLibraryItem">
                    <lookup name="item">GtkListItem</lookup>
                  </lookup>
                </binding>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <binding name="label">
                  <lookup name="title" type="ViewerLibraryItem">
                    <lookup name="item">GtkListItem</lookup>
                  </lookup>
                </binding>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
